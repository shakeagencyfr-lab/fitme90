# ------------------------------------------------------------------
# FitMe90 — variables d'environnement (modèle)
# Copie ce fichier en .env.local et renseigne les valeurs.
# .env.local n'est JAMAIS commité (voir .gitignore).
# Aucune clé secrète ne doit être préfixée NEXT_PUBLIC_.
# ------------------------------------------------------------------

# --- Supabase (région UE) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=          # serveur uniquement — contourne le RLS

# --- Anthropic (appelé uniquement côté serveur) ---
# Clé par défaut (repli). En multi-tenant (BYOK), chaque coach fournit SA clé
# depuis /admin/compte ; elle est chiffrée en base et prime sur celle-ci.
ANTHROPIC_API_KEY=

# --- Chiffrement des secrets (BYOK) ---
# Clé maître AES-256 pour chiffrer les clés Anthropic des tenants au repos.
# 32 octets : hex de 64 caractères OU base64. Génère : openssl rand -hex 32
SECRETS_ENC_KEY=

# --- Stripe ---
STRIPE_SECRET_KEY=                  # sk_test_... puis sk_live_...
STRIPE_WEBHOOK_SECRET=              # whsec_... (donné par `stripe listen` ou le dashboard)
# Commission plateforme par défaut sur les ventes Connect, en points de base
# (100 = 1 %). Vide/0 = aucune commission. Surchargeable par tenant en base.
PLATFORM_FEE_BPS=

# --- Site ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Admin (dashboard coach) ---
# E-mails autorisés à accéder à /admin, séparés par des virgules.
# Fermé par défaut : si vide, personne n'est admin.
ADMIN_EMAILS=
