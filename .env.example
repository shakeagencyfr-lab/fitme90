# ------------------------------------------------------------------
# FitMe90 — variables d'environnement (modèle)
# Copie ce fichier en .env.local et renseigne les valeurs.
# .env.local n'est JAMAIS commité (voir .gitignore).
# Aucune clé secrète ne doit être préfixée NEXT_PUBLIC_.
# ------------------------------------------------------------------

# --- Supabase (région UE) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=          # serveur uniquement — contourne le RLS

# --- Anthropic (appelé uniquement côté serveur) ---
# Clé par défaut (repli). En multi-tenant (BYOK), chaque coach fournit SA clé
# depuis /admin/compte ; elle est chiffrée en base et prime sur celle-ci.
ANTHROPIC_API_KEY=

# --- Chiffrement des secrets (BYOK) ---
# Clé maître AES-256 pour chiffrer les clés Anthropic des tenants au repos.
# 32 octets : hex de 64 caractères OU base64. Génère : openssl rand -hex 32
SECRETS_ENC_KEY=

# --- Stripe (plateforme, pour l'app FitMe90 historique) ---
# NB : en marque blanche, chaque coach fournit SA propre clé Stripe (BYOK) depuis
# /admin/paiements ; ces variables ne servent que pour le paiement FitMe90 direct.
STRIPE_SECRET_KEY=                  # sk_test_... puis sk_live_...
STRIPE_WEBHOOK_SECRET=              # whsec_... (donné par `stripe listen` ou le dashboard)

# --- Site ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Domaine racine pour les sous-domaines coach (ex "fitme90.com"), sans protocole
# ni www. Vide = sous-domaines personnalisés inactifs. Voir DEPLOY.md §6 bis.
NEXT_PUBLIC_ROOT_DOMAIN=

# --- E-mails transactionnels (Resend) ---
# Clé API Resend (envoi des notifications de l'app : messages VIP, etc.).
# Le domaine d'expédition doit être vérifié dans Resend (SPF/DKIM sur le DNS).
RESEND_API_KEY=                     # re_...
# Expéditeur par défaut. Adresse d'un domaine vérifié chez Resend.
RESEND_FROM=My Fitness App <notifications@myfitnessapp.fit>

# --- Admin (dashboard coach) ---
# E-mails autorisés à accéder à /admin, séparés par des virgules.
# Fermé par défaut : si vide, personne n'est admin.
ADMIN_EMAILS=

# Domaine personnalisé des coachs (marque blanche totale), optionnel : avec un
# jeton Vercel, le domaine saisi par le coach est rattaché au projet et le
# certificat HTTPS émis automatiquement. Sans jeton, le coach reçoit quand même
# ses enregistrements DNS et la plateforme ajoute le domaine dans Vercel à la main.
VERCEL_TOKEN=
VERCEL_PROJECT_ID=
VERCEL_TEAM_ID=
